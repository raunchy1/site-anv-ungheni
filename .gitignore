# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Datele brute de migrare (products.ndjson, pages.json, urls.json, jurnalele)
# SUNT in git: sunt sursa din care s-a construit catalogul, nu se regenereaza
# identic si nu incap in alta parte. Raman afara doar cache-urile grele, care
# se refac rulandu-l pe scraper.
data/raw/images/
data/raw/html-cache/
data/raw/*.bak

# Logo-urile de marca si candidatii lor: sunt in git ca backup complet.
# Sursa de adevar in productie ramane Supabase Storage.

# Cache-ul HTTP si starea sincronizarii pandashop: ~340 MB de pagini descarcate,
# se regenereaza la prima rulare. Nu intra in git.
data/sync/

# Rapoartele de sincronizare: .md-ul se pastreaza, JSON-ul brut (megaocteti) nu.
reports/sync/*.json

# Exceptia: copiile de siguranta de dinaintea unei stergeri. Sunt singurul drum
# inapoi pentru randuri care nu mai exista in baza, deci intra in git chiar daca
# sunt JSON de un megaoctet.
!reports/sync/scoatere-branduri-*.json
