# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/raw/*.ndjson
data/raw/pages.json

# date de migrare — volum mare, se regenerează din scraper
data/raw/images/
data/raw/html-cache/
data/raw/*.bak
data/raw/*.log

# logo-urile de marca: sursa de adevar e Supabase Storage, nu repo-ul.
# Manifestul ramane in git — el spune de unde vine fiecare fisier.
logos-sursa/*
!logos-sursa/manifest.json
# candidatii bruti (94 de fisiere de pe site-uri oficiale) raman locali;
# raportul lor spune ce s-a gasit si de unde
logos-candidate/*
!logos-candidate/candidati.json

# Cache-ul și starea sincronizării pandashop. Se regenerează; nu intră în git.
data/sync/

# Rapoartele de sincronizare: .md-ul se pastreaza, JSON-ul brut (megaocteti) nu.
reports/sync/*.json
