# Copiază în .env.local și completează. .env.local nu intră niciodată în git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Doar server. Ocolește RLS. Nu se expune clientului.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

SUPABASE_STORAGE_BUCKET=produse

# Notificarea de comandă. Cheia de la resend.com; expeditorul trebuie să fie pe
# un domeniu verificat acolo. ORDER_NOTIFY_EMAIL e cutia care primește comenzile
# (una sau mai multe, separate prin virgulă); fără ea se folosește settings.email.
RESEND_API_KEY=
RESEND_FROM="Anvelope Ungheni <comenzi@anvelope-ungheni.md>"
ORDER_NOTIFY_EMAIL=

# Plasa de siguranta cat timp domeniul nu e verificat in Resend: daca trimiterea
# normala e refuzata, comanda pleaca de la expeditorul de test catre adresa
# contului Resend. Se sterg amandoua dupa verificarea domeniului.
RESEND_FALLBACK_TO=
RESEND_FALLBACK_FROM="Anvelope Ungheni <onboarding@resend.dev>"

# Cronul de sincronizare pandashop.
CRON_SECRET=
SYNC_ALERT_EMAIL=
